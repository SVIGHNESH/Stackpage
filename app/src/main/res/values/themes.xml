<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      A bare splash theme only. Every colour the user sees comes from the
      Compose theme, so this stays minimal and matches the paper background to
      avoid a white or black flash before the first frame.
    -->
    <style name="Theme.Stackpage" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
