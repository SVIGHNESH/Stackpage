<?xml version="1.0" encoding="utf-8"?>
<!--
  Three offset pages collapsing into one. The mark is the product: a stack
  becoming a document. Drawn on the 108dp adaptive canvas with the art kept
  inside the 66dp safe zone so no launcher mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- back sheet -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.35"
        android:pathData="M36,28 h30 a4,4 0 0 1 4,4 v44 a4,4 0 0 1 -4,4 h-30 a4,4 0 0 1 -4,-4 v-44 a4,4 0 0 1 4,-4 z" />

    <!-- middle sheet -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.6"
        android:pathData="M40,32 h30 a4,4 0 0 1 4,4 v44 a4,4 0 0 1 -4,4 h-30 a4,4 0 0 1 -4,-4 v-44 a4,4 0 0 1 4,-4 z" />

    <!-- front sheet -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M44,36 h30 a4,4 0 0 1 4,4 v44 a4,4 0 0 1 -4,4 h-30 a4,4 0 0 1 -4,-4 v-44 a4,4 0 0 1 4,-4 z" />

    <!-- image mark on the front sheet: horizon and sun -->
    <path
        android:fillColor="#1E3A5F"
        android:pathData="M48,72 l9,-12 7,9 5,-6 6,9 z" />
    <path
        android:fillColor="#1E3A5F"
        android:pathData="M55,49 m-4,0 a4,4 0 1 0 8,0 a4,4 0 1 0 -8,0" />
</vector>
